# Copy this file to .env. Never commit the copy.
DJANGO_SECRET_KEY=replace-with-a-local-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

POSTGRES_DB=accesspath
POSTGRES_USER=accesspath
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Leave blank until Phase 1D quota preflight has passed.
GEMINI_API_KEY=
GEMINI_MODEL=
# Selectable live-provider alternative. Use an exact model ID that supports
# OpenRouter strict JSON-schema output, then run preflight_openrouter first.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Groq LPU API for reliable, fast structured output without hitting free-tier limits.
GROQ_API_KEY=
GROQ_MODEL=
PLANNER_MAX_CALLS_PER_RUN=40
PLANNER_CALL_TIMEOUT_SECONDS=30
PLANNER_MIN_CALL_INTERVAL_SECONDS=15
PLANNER_MAX_429_RETRIES=1
PLANNER_429_BACKOFF_SECONDS=30
PLANNER_MAX_TRANSIENT_RETRIES=5
PLANNER_TRANSIENT_BACKOFF_SECONDS=15

FIXTURE_ALLOWED_ORIGINS=http://127.0.0.1:8001
ALLOW_PRIVATE_NETWORKS=false
EVALUATOR_MAX_STEPS=56
EVALUATOR_ACTION_TIMEOUT_MS=5000
EVALUATOR_HEADLESS=true
EVALUATOR_BROWSER_EXECUTABLE=
# Opt in only when intentionally running the reviewed, read-only public journey.
RUN_APPROVED_LIVE_TESTS=false
