    classDef external fill:#fff7ed,stroke:#ea580c,color:#7c2d12,stroke-width:1px;
    classDef store fill:#faf5ff,stroke:#9333ea,color:#581c87,stroke-width:1px;
    class Evaluator,Developer,Assistant,EndUser,WebUI,CLI,GHA,MCP,Extension entry;
    class Django,CLIRuntime,BrowserWorker,RepoWorker app;
    class DB,Redis,Evidence store;
    class Observe,Planner,Policy,Playwright,Checks,Result,Locator engine;
    class Providers,Site,Repository,Reports,ActiveTab,Speech external;
