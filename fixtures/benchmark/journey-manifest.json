      "key": "bench-newsletter-accessible",
      "name": "Benchmark — newsletter sign-up (accessible reference)",
      "goal": "Subscribe to the newsletter with the email address provided, using only the keyboard.",
      "execution_mode": "fixture",
      "start_path": "/benchmark/newsletter-accessible.html",
      "allowed_origins": [
        "{fixture_base_url}"
      ],
      "completion_policy": {
        "schema_version": "completion_policy.v1",
        "mode": "all",
        "signals": [
          {
            "id": "subscribed",
            "type": "text_present",
            "expected": "Subscribed"
          }
        ],
        "stability": {
          "consecutive_observations": 2,
          "interval_ms": 500
        }
      },
      "evaluation_config": {
        "planner": {
          "kind": "gemini.v1",
          "fallback": {
            "kind": "fixture_plan.v1",
            "actions": [
              {
                "action": "tab",
                "purpose": "focus the email field",
                "target_hint": "Email address"
              },
              {
                "action": "type",
                "purpose": "enter the synthetic email",
                "target_hint": "Email address",
                "value": "{email}"
              },
              {
                "action": "tab",
                "purpose": "focus Subscribe",
                "target_hint": "Subscribe"
              },
              {
                "action": "enter",
                "purpose": "subscribe",
                "target_hint": "Subscribe"
              }
            ],
            "synthetic_values": {
              "email": "asha.test@example.invalid"
            }
          }
        }
      },
      "expected": {
        "outcome": "completed",
        "confirmed_rules": []
      }
    },
