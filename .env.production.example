# Example only. Production secrets belong in a cloud secret manager, not this file.
DJANGO_SECRET_KEY=replace-through-your-secret-manager
DJANGO_ALLOWED_HOSTS=app.example.edu
SECURE_HSTS_SECONDS=31536000

POSTGRES_DB=accesspath
POSTGRES_USER=accesspath
POSTGRES_PASSWORD=replace-through-your-secret-manager
POSTGRES_HOST=managed-postgres.internal
POSTGRES_PORT=5432

REDIS_URL=rediss://managed-redis.internal:6379/0
CELERY_RESULT_BACKEND=rediss://managed-redis.internal:6379/1

ALLOW_PRIVATE_NETWORKS=false
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ACKS_LATE=true
CELERY_WORKER_MAX_TASKS_PER_CHILD=10
CELERY_WORKER_MAX_MEMORY_PER_CHILD=1500000
